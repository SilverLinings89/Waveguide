# Default run: two processes, one sweep in the z-direction (mpirun -np 2 main).
subsection Run parameters
  set sweeping level  = 1
  set processes in x  = 1
  set processes in y  = 1
  set processes in z  = 2
  set cell count x    = 16
  set cell count y    = 16
  set cell count z    = 8
  set solver precision = 1e-6
  set Logging Level   = Production One
end
