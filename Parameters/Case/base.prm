# Default case: a short, straight waveguide. The fundamental mode is prescribed as Dirichlet data on the input
# interface and the domain is truncated by PML on all other sides.
subsection Case parameters
  set source type          = 3
  set fem order            = 0
  set geometry size x      = 4.0
  set geometry size y      = 3.6
  set geometry size z      = 3.0
  set epsilon in           = 2.3409
  set epsilon out          = 1.8496
  set Boundary Method      = PML
  set PML n layers         = 6
  set PML thickness        = 0.5
  set PML sigma max        = 10
  set PML skaling order    = 2
  set Input Signal Method  = Dirichlet
end
